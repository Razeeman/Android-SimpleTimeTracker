<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        style="@style/SettingsSecondaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/edit_screen_margin_horizontal"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:text="@string/change_record_type_goal_time_description" />

    <com.example.util.simpletimetracker.feature_views.HintBigView
        android:id="@+id/changeGoalNotificationsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/edit_screen_margin_horizontal"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:itemActionButtonText="@string/schedule_exact_alarms_open_settings"
        app:itemActionButtonVisible="true"
        app:itemCloseIconVisible="false"
        app:itemHintText="@string/post_notifications"
        app:itemInfoIconVisible="false"
        tools:visibility="visible" />

</androidx.appcompat.widget.LinearLayoutCompat>
