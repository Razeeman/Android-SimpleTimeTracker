<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/containerChangeRecordTypeGradientControls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/btnChangeRecordTypeGradientStart"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginEnd="4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toStartOf="@id/btnChangeRecordTypeGradientEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="?appInputFieldBorder">

        <View
            android:id="@+id/viewChangeRecordTypeGradientStartColor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:elevation="4dp"
            tools:background="@color/red_400" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/EditScreenField"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/color_selection_gradient_main_color" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnChangeRecordTypeGradientEnd"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnChangeRecordTypeGradientStart"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/viewChangeRecordTypeGradientEndColor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:elevation="4dp"
            tools:background="@color/amber_400" />

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/EditScreenField"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:maxLines="2"
            android:text="@string/color_selection_gradient" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvChangeRecordTypeGradientAngleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:text="@string/color_selection_gradient_angle_label"
        android:textColor="?appTextPrimaryColor"
        android:textSize="16sp"
        app:layout_constraintEnd_toStartOf="@id/tvChangeRecordTypeGradientAngle"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnChangeRecordTypeGradientStart" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvChangeRecordTypeGradientAngle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:textColor="?appTextHintColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/tvChangeRecordTypeGradientAngleLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvChangeRecordTypeGradientAngleLabel"
        app:layout_constraintTop_toTopOf="@id/tvChangeRecordTypeGradientAngleLabel"
        tools:text="90" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderChangeRecordTypeGradientAngle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/color_selection_gradient_angle_label"
        android:stepSize="5"
        android:valueFrom="0"
        android:valueTo="360"
        app:labelBehavior="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvChangeRecordTypeGradientAngleLabel"
        app:tickVisible="false"
        tools:value="45" />

</androidx.constraintlayout.widget.ConstraintLayout>
